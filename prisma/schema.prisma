// Nori data model. See docs/SPEC.md §5.
//
// TWO INVARIANTS THAT MUST NOT BE BROKEN:
//
//  1. Every monetary amount is an Int in the currency's MINOR unit, paired
//     with an ISO-4217 code. £12.34 is 1234 + "GBP". Never Float, never
//     Decimal above the DB layer. Float corruption in a ledger is silent and
//     unrecoverable once rows exist. All arithmetic goes through lib/money.ts.
//
//  2. Every user-owned row hangs off a Workspace, never directly off a User.
//     v1 shows no workspace switcher, but the boundary exists in the schema
//     and in every query, so adding teams later is additive UI work rather
//     than a migration across every table.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts for the CLI, and is
// supplied to PrismaClient at runtime through a driver adapter (lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Argon2id. Null for OAuth-only accounts, which have no password to verify.
  passwordHash String?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  receipts    Receipt[]    @relation("UploadedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Auth.js standard shape. Retained even under the JWT session strategy so
// OAuth account linking keeps working when a provider is configured.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Tenancy ───────────────────────────────────────────────────────────────

model Workspace {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  personal Boolean @default(true)
  /// Default for new receipts that print no currency of their own.
  currency String  @default("GBP")

  members    Membership[]
  receipts   Receipt[]
  expenses   Expense[]
  categories Category[]
  merchants  Merchant[]

  createdAt DateTime @default(now())

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(OWNER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ─── Receipts ──────────────────────────────────────────────────────────────

enum ReceiptStatus {
  UPLOADED
  QUEUED
  PREPROCESSING
  OCR_RUNNING
  EXTRACTING
  NEEDS_REVIEW
  CONFIRMED
  FAILED
}

enum ExtractionPath {
  TEXT
  VISION
}

model Receipt {
  id           String        @id @default(cuid())
  workspaceId  String
  uploadedById String
  status       ReceiptStatus @default(UPLOADED)

  /// MinIO object key. Null while storage upload is not yet wired.
  objectKey String?
  mimeType  String
  byteSize  Int
  /// Dedupe key: the same file twice links to the existing receipt rather
  /// than paying to process it again.
  checksumSha256 String

  originalName String?
  imageWidth   Int?
  imageHeight  Int?

  ocrText       String? @db.Text
  /// [{ text, confidence, bbox:[x0,y0,x1,y1] }] — drives the review screen's
  /// field-to-image highlighting (spec §8.5).
  ocrWords      Json?
  ocrConfidence Float?
  ocrEngine     String?

  extractionPath ExtractionPath?
  pathReason     String?

  errorCode    String?
  errorMessage String?
  processedAt  DateTime?

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("UploadedBy", fields: [uploadedById], references: [id])
  expense    Expense?
  runs       ProcessingRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, checksumSha256])
  @@index([workspaceId, status, createdAt])
  @@map("receipts")
}

model Expense {
  id          String  @id @default(cuid())
  workspaceId String
  receiptId   String  @unique
  merchantId  String?
  categoryId  String?

  purchasedAt DateTime
  currency    String

  // Minor units. See the header of this file.
  subtotal Int?
  taxTotal Int?
  tipTotal Int?
  total    Int

  paymentMethod String?
  cardLast4     String?

  notes           String?
  categoryReason  String?
  /// Mean of the model's own per-field confidences, 0-1.
  confidence      Float   @default(0)
  needsReview     Boolean @default(true)
  /// Reconciliation output, kept so the review screen can show why.
  warnings        Json?
  reviewedAt      DateTime?
  reviewedById    String?
  /// Which fields a human overrode — the signal for §7.5 learning.
  editedFields    String[] @default([])

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receipt   Receipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  merchant  Merchant?  @relation(fields: [merchantId], references: [id])
  category  Category?  @relation(fields: [categoryId], references: [id])
  lineItems LineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, purchasedAt])
  @@index([workspaceId, categoryId])
  @@map("expenses")
}

model LineItem {
  id          String  @id @default(cuid())
  expenseId   String
  lineNumber  Int
  description String
  /// 0.85 kg is a legitimate quantity, so this one is genuinely fractional.
  quantity    Decimal @default(1) @db.Decimal(10, 3)
  unitPrice   Int?
  total       Int
  categoryId  String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("line_items")
}

model Merchant {
  id             String  @id @default(cuid())
  workspaceId    String
  /// As printed on the receipt.
  name           String
  /// Lowercased, punctuation stripped — the match key.
  normalizedName String
  /// Learned from corrections: "this shop is always Groceries". Lets the next
  /// receipt from here skip the categorisation work entirely.
  defaultCategoryId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  createdAt DateTime @default(now())

  @@unique([workspaceId, normalizedName])
  @@map("merchants")
}

model Category {
  id          String  @id @default(cuid())
  /// Null marks a system default; each workspace gets its own copies on create.
  workspaceId String?
  slug        String
  name        String
  icon        String
  /// Index into the --chart-N ramp in globals.css, never a hex literal.
  chart       Int     @default(1)
  isSystem    Boolean @default(false)
  sortOrder   Int     @default(0)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("categories")
}

// ─── Observability ─────────────────────────────────────────────────────────

/// One row per pipeline stage. This table is how a bad extraction gets
/// debugged and how spend is accounted for after the fact.
model ProcessingRun {
  id            String  @id @default(cuid())
  receiptId     String
  stage         String
  status        String
  model         String?
  promptVersion String?
  inputTokens   Int?
  outputTokens  Int?
  /// Millionths of a currency unit, so sub-cent costs stay integers.
  costMicros    Int?
  latencyMs     Int
  rawResponse   Json?
  error         String?

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([receiptId, createdAt])
  @@map("processing_runs")
}
