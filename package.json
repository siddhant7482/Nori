{
  "name": "commandhq-nori",
  "version": "0.1.0",
  "private": true,
  "description": "Money for CommandHQ. The bank is the referee: Monzo's feed is the record, budgets run payday to payday, and nothing is typed in.",
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "next start -p 3006",
    "typecheck": "tsc --noEmit",
    "check": "tsx src/lib/month.check.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sync": "tsx src/monzo/run-sync.ts",
    "seed:example": "tsx src/db/seed-example.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.18.3"
}
