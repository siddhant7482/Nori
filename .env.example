# ---------------------------------------------------------------------------
# Nori's own database on the shared Postgres (CT 100), one per app.
# For development use nori_dev, never nori: the example seed refuses to run
# against a database that holds a real Monzo connection, but don't test that.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://commandhq:PASSWORD@192.168.0.100:5432/nori_dev"

# ---------------------------------------------------------------------------
# Monzo. Create a client at https://developers.monzo.com (Clients -> New
# OAuth Client). Choose CONFIDENTIAL: only confidential clients get refresh
# tokens, and without one Nori loses access every six hours.
#
# The redirect URL must match the one registered on the client exactly.
# It only has to resolve in YOUR browser, so a LAN name is fine.
# ---------------------------------------------------------------------------
MONZO_CLIENT_ID=""
MONZO_CLIENT_SECRET=""
MONZO_REDIRECT_URI="http://nori.hq.siddhantbhasin.me/api/monzo/callback"

# ---------------------------------------------------------------------------
# Encrypts the Monzo tokens before they touch Postgres. Same scheme as
# Warden's Gmail token. Losing it means connecting Monzo again, which after
# the first five minutes only reaches 90 days back; history already synced
# is kept.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Development only. Pins "today" so the example cycle reads exactly like
# the design mock (day 19 of 31). Never set it on the node.
# ---------------------------------------------------------------------------
# NORI_TODAY="2026-09-12"
