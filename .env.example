# Copy to .env and fill in. lib/env.ts validates all of this at boot and
# refuses to start if anything is missing or malformed.

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://nori:nori@localhost:5432/nori"

# ─── Auth.js ─────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional. Omit both and the Google button is hidden.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Omit both and magic-link sign-in is hidden.
# Mailhog (docker compose) catches everything at http://localhost:8025
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Nori <noreply@nori.local>"

# ─── MinIO / S3 ──────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="nori-receipts"
S3_ACCESS_KEY_ID="nori"
S3_SECRET_ACCESS_KEY="noripassword"
# MinIO addresses buckets by path, not subdomain. Leave true unless you have
# moved to real S3 or R2.
S3_FORCE_PATH_STYLE="true"
# Only set this if the browser reaches MinIO on a different host than the
# server does (e.g. app in Docker, browser on the host).
# S3_PUBLIC_ENDPOINT="http://localhost:9000"

# ─── OpenRouter ──────────────────────────────────────────────────────────
# https://openrouter.ai/keys — leave blank to run OCR only.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Must support strict json_schema structured outputs.
OPENROUTER_EXTRACT_MODEL="openai/gpt-4.1-mini"
OPENROUTER_SUMMARY_MODEL="openai/gpt-4.1-mini"
# Optional attribution headers shown on OpenRouter's leaderboards.
# OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Nori"

# ─── Limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES="10485760"      # 10 MB
DAILY_RECEIPT_LIMIT="200"        # per workspace, per day
OCR_WORKER_POOL_SIZE="2"         # match to available cores
OCR_MIN_CONFIDENCE="40"          # below this, fail fast instead of calling the LLM
WORKER_PORT="3001"
